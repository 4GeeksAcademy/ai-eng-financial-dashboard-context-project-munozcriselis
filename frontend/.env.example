# Backend that Next.js proxies /api/* to (rewrite in next.config.ts).
# Defaults to http://backend:8000 (docker compose service).
# Outside Docker: API_PROXY_TARGET=http://localhost:8000
API_PROXY_TARGET=

# Optional override for the backend base URL used directly by the browser.
# Leave empty to use the same-origin /api proxy.
NEXT_PUBLIC_API_BASE_URL=
